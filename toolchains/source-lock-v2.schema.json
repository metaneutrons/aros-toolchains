{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metaneutrons/aros-toolchains/toolchains/source-lock-v2.schema.json",
  "title": "AROS toolchain source lock v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "family", "version", "sources", "host_python_packages"],
  "properties": {
    "schema": { "const": "aros-toolchain-source-lock-v2" },
    "family": { "const": "llvm" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "version", "purpose", "filename", "url", "sha256", "size"],
        "properties": {
          "component": { "type": "string", "pattern": "^[A-Za-z0-9+._-]+$" },
          "version": { "type": "string", "pattern": "^[A-Za-z0-9+._-]+$" },
          "purpose": { "enum": ["toolchain-component", "target-build-dependency"] },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9+._-]+$" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "host_python_packages": {
      "description": "Pinned pure-Python host build dependencies, consumed only through the isolated release helper.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "filename",
          "url",
          "sha256",
          "size",
          "source_root",
          "python_path"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9+._-]+$" },
          "version": { "type": "string", "pattern": "^[A-Za-z0-9+._-]+$" },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9+._-]+$" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "source_root": { "type": "string", "pattern": "^[A-Za-z0-9+._-]+$" },
          "python_path": { "type": "string", "pattern": "^(\\.|[A-Za-z0-9+._/-]+)$" }
        }
      }
    }
  }
}
