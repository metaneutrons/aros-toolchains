{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metaneutrons/AROS-NG/toolchains/source-lock-v1.schema.json",
  "title": "AROS-NG toolchain source lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "family", "version", "sources"],
  "properties": {
    "schema": { "const": "aros-ng-toolchain-source-lock-v1" },
    "family": { "const": "llvm" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "filename", "url", "sha256", "size"],
        "properties": {
          "component": { "type": "string", "pattern": "^[A-Za-z0-9+._-]+$" },
          "filename": { "type": "string", "pattern": "^[A-Za-z0-9+._-]+$" },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
