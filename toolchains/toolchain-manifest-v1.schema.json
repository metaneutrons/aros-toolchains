{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/metaneutrons/AROS-NG/toolchains/toolchain-manifest-v1.schema.json",
  "title": "AROS-NG release toolchain manifest v1",
  "type": "object",
  "required": [
    "schema",
    "release_id",
    "host",
    "target_profile",
    "target_triple",
    "tree_sha256",
    "llvm_version",
    "recipe_sha256",
    "source_lock_sha256",
    "profiles_sha256",
    "source_commit",
    "source_date_epoch",
    "capabilities",
    "build_environment",
    "files"
  ],
  "properties": {
    "schema": { "const": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "host": {
      "enum": [
        "linux-x86_64",
        "linux-aarch64",
        "macos-x86_64",
        "macos-aarch64"
      ]
    },
    "target_profile": {
      "enum": ["pc-x86_64", "arm-raspi", "rpi-aarch64"]
    },
    "target_triple": {
      "enum": ["x86_64-unknown-aros", "arm-unknown-aros", "aarch64-unknown-aros"]
    },
    "tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "llvm_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "recipe_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "profiles_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_date_epoch": { "type": "integer", "minimum": 0 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "build_environment": { "type": "object" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "type"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "mode": { "const": "0755" },
              "type": { "const": "directory" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "type", "target"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "mode": { "const": "0777" },
              "type": { "const": "symlink" },
              "target": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "type", "sha256", "size"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["0644", "0755"] },
              "type": { "const": "file" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size": { "type": "integer", "minimum": 0 }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
